{
  "name": "roam-app",
  "private": true,
  "scripts": {
    "prepare": "pnpm exec turbo run build --filter=@roam/db",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "render:build:api": "pnpm install --frozen-lockfile && pnpm --filter=@roam/types build && pnpm --filter=@roam/marking-fingerprint build && pnpm --filter=@roam/db build && pnpm --filter=@roam/api build",
    "verify:deploy": "node scripts/verify-deploy-health.mjs",
    "supabase:bundle": "node scripts/bundle-supabase-migrations.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "expo-constants": "16.0.2",
      "expo-linking": "6.3.1",
      "react-native-screens": "3.31.1"
    },
    "patchedDependencies": {
      "expo-sqlite@14.0.6": "patches/expo-sqlite@14.0.6.patch",
      "expo-modules-core@1.12.26": "patches/expo-modules-core@1.12.26.patch"
    }
  }
}
