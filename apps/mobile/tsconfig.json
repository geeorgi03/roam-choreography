{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@roam/db": ["../../packages/db/dist"],
      "@roam/types": ["../../packages/types/src"]
    },
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noImplicitReturns": false
  },
  "include": ["**/*.ts", "**/*.tsx"]
}